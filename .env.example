# Database URL for PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/spielfranzen?schema=public"

# JWT Secret for authentication
JWT_SECRET="your_secure_jwt_secret_change_in_production"

# Backend server port
PORT=3001

# Allowed CORS origin
CORS_ORIGIN="http://localhost:5173"

# Google OAuth 2.0 Credentials (Google Cloud Console -> Credentials -> OAuth 2.0 Client IDs -> Web application)
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
VITE_GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
