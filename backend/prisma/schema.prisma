datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               String             @id @default(uuid())
  username         String             @unique
  email            String             @unique
  passwordHash     String?
  googleId         String?            @unique
  avatarUrl        String?
  lifetimeScore    Int                @default(0)
  eloRating        Int                @default(1000)
  matchesPlayed    Int                @default(0)
  matchesWon       Int                @default(0)
  soloGamesPlayed  Int                @default(0)
  soloGamesWon     Int                @default(0)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  hostedMatches    Match[]            @relation("HostMatches")
  participations   MatchParticipant[]

  @@index([lifetimeScore])
  @@index([eloRating])
  @@index([googleId])
}

model Match {
  id             String             @id @default(uuid())
  code           String             @unique
  name           String?
  gameType       String             @default("franzen") // franzen, watten_2, watten_4, schnapsen_2, schnapsen_3
  maxPlayers     Int                @default(3)
  hostId         String
  isPrivate      Boolean            @default(false)
  status         String             @default("WAITING") // WAITING, IN_PROGRESS, COMPLETED, ABANDONED
  totalRounds    Int                @default(15)
  currentRound   Int                @default(1)
  liveGameState  Json?
  createdAt      DateTime           @default(now())
  completedAt    DateTime?

  host           User               @relation("HostMatches", fields: [hostId], references: [id])
  participants   MatchParticipant[]
  rounds         MatchRound[]

  @@index([status])
  @@index([code])
}

model MatchParticipant {
  id                String   @id @default(uuid())
  matchId           String
  userId            String
  seatIndex         Int      // 0, 1, 2
  isBot             Boolean  @default(false)
  botName           String?
  currentMatchScore Int      @default(0)
  finalRank         Int?

  match             Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([matchId, seatIndex])
  @@index([userId])
}

model MatchRound {
  id                  String   @id @default(uuid())
  matchId             String
  roundNumber         Int
  dealerSeat          Int
  declarerSeat        Int
  gameMode            Int      // 5-12
  declarerWon         Boolean
  declarerCardPoints  Int
  defenderCardPoints  Int
  scoreDeltaDeclarer  Int
  scoreDeltaDefenders Int
  createdAt           DateTime @default(now())

  match               Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([matchId])
}
